#!/bin/bash

## Description: Create/remove a parallel git worktree with its own DDEV project.
## Usage: worktree add <branch> [slug] | worktree remove <slug> [--force]
## Example: "ddev worktree add feature/ABC-123_topic" or "ddev worktree remove abc-123-topic --force"

set -e -u -o pipefail

cd "$DDEV_APPROOT"

MSG_ERROR="\033[41m[ error ]\033[0m"
MSG_WARNING="\033[43m[ warning ]\033[0m"
MSG_SUCCESS="\033[42m[ success ]\033[0m"
MSG_INFO="\033[44m[ info ]\033[0m"

PREFIX="{{ name }}-"

worktree_add() {
  BRANCH="${1:-}"
  SLUG="${2:-}"
  if [ -z "$BRANCH" ]; then
    echo -e " $MSG_ERROR Missing branch. Usage: ddev worktree add <branch> [slug]"
    exit 1
  fi
  if [ -z "$SLUG" ]; then
    SLUG=$(basename "$BRANCH" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-24 | sed -E 's/-+$//')
  fi
  if [ -z "$SLUG" ]; then
    echo -e " $MSG_ERROR Could not derive a slug from \"$BRANCH\". Pass one explicitly: ddev worktree add <branch> <slug>"
    exit 1
  fi
  NAME="$PREFIX${SLUG#"$PREFIX"}"
  WORKTREE_PATH="../$NAME"
  if [ -e "$WORKTREE_PATH" ]; then
    echo -e " $MSG_ERROR \"$WORKTREE_PATH\" already exists."
    exit 1
  fi
  echo -e " $MSG_INFO Creating worktree \"$NAME\" for branch \"$BRANCH\""
  if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git worktree add "$WORKTREE_PATH" "$BRANCH"
  elif git show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
    git worktree add --track -b "$BRANCH" "$WORKTREE_PATH" "origin/$BRANCH"
  else
    echo -e " $MSG_INFO Branch \"$BRANCH\" does not exist yet. Creating it from the current HEAD."
    git worktree add -b "$BRANCH" "$WORKTREE_PATH"
  fi
  printf '%s\n' \
    '# Generated by "ddev worktree" — per-worktree DDEV override, do not commit.' \
    "name: $NAME" \
    "web_environment:" \
    "    - NUXT_REQUEST_HOST=$NAME.ddev.site" \
    > "$WORKTREE_PATH/.ddev/config.local.yaml"
  for ENV_FILE in .ddev/.env .ddev/.env.* drupal/.env frontend/.env; do
    if [ -f "$ENV_FILE" ]; then
      cp "$ENV_FILE" "$WORKTREE_PATH/$ENV_FILE"
    fi
  done
  echo -e " $MSG_SUCCESS Worktree created at \"$WORKTREE_PATH\" (DDEV project \"$NAME\")"
  echo -e " $MSG_INFO No runtime has been provisioned. If you need the tooling (composer, drush, bun, tests), run:"
  echo -e " $MSG_INFO   cd $WORKTREE_PATH && make install"
}

worktree_remove() {
  SLUG="${1:-}"
  FORCE="${2:-}"
  if [ -z "$SLUG" ]; then
    echo -e " $MSG_ERROR Missing slug. Usage: ddev worktree remove <slug> [--force]"
    exit 1
  fi
  NAME="$PREFIX${SLUG#"$PREFIX"}"
  WORKTREE_PATH="../$NAME"
  if [ ! -d "$WORKTREE_PATH" ]; then
    echo -e " $MSG_ERROR \"$WORKTREE_PATH\" does not exist."
    exit 1
  fi
  if [ "$FORCE" != "--force" ] && [ -n "$(git -C "$WORKTREE_PATH" status --porcelain)" ]; then
    echo -e " $MSG_ERROR Worktree has modified or untracked files (e.g. a provisioned runtime). Check for unsaved work, then re-run with --force."
    exit 1
  fi
  echo -e " $MSG_INFO Deleting DDEV project \"$NAME\""
  ddev delete --omit-snapshot --yes "$NAME" || echo -e " $MSG_WARNING No DDEV project \"$NAME\" to delete."
  rm -f "$WORKTREE_PATH/.ddev/config.local.yaml"
  if [ "$FORCE" = "--force" ]; then
    git worktree remove --force "$WORKTREE_PATH"
  elif ! git worktree remove "$WORKTREE_PATH"; then
    echo -e " $MSG_ERROR Worktree has modified or untracked files (e.g. a provisioned runtime). Check for unsaved work, then re-run with --force."
    exit 1
  fi
  echo -e " $MSG_SUCCESS Worktree \"$NAME\" removed."
}

case "${1:-}" in
  add) shift; worktree_add "$@" ;;
  remove) shift; worktree_remove "$@" ;;
  *)
    echo -e " $MSG_ERROR Usage: ddev worktree add <branch> [slug] | ddev worktree remove <slug> [--force]"
    exit 1
    ;;
esac
