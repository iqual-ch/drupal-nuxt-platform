name: {{ name }}
type: drupal
docroot: drupal/docroot
php_version: "{{ runtime.php_version }}"
webserver_type: nginx-fpm
xdebug_enabled: false
# The Drupal backend is served on its own hostname (see docs/routing.md). To
# test a www frontend, add www.{{ name }} in .ddev/config.local.yaml.
additional_hostnames:
    - backend.{{ name }}
additional_fqdns: []
database:
    type: mariadb
    version: "{{ runtime.db_version }}"
working_dir:
    web: /var/www/html/drupal
use_dns_when_possible: true
timezone: Europe/Zurich
composer_root: drupal
composer_version: "2"
corepack_enable: false
ddev_version_constraint: '>= 1.24.0'
web_environment:
    - APP_ENV=local
{% if deployment == "platform.sh" %}
    - DRUPAL_SPOT={{ drupal_spot }}
    - DRUPAL_SPOT_ORIGIN={{ url }}
{% endif %}
    - NODE_ENV=development
    - NUXT_BACKEND_URL=http://localhost:8888
    - NUXT_REQUEST_HOST=$DDEV_SITENAME.$DDEV_TLD
    - DRUPAL_GRAPHQL_TOKEN=local-development
    - NUXT_MULTI_CACHE_API_AUTHORIZATION_TOKEN=local-development
{% if runtime.elasticsearch_version %}
    - NUXT_ELASTICSEARCH_URL=http://elasticsearch:9200
{% endif %}
    - NUXT_PUBLIC_IMAGE_BASE_URL={{ url }}
    - SIMPLETEST_DB=$DDEV_DATABASE_FAMILY://db:db@db/db
    - SIMPLETEST_BASE_URL=https://backend.$DDEV_SITENAME.$DDEV_TLD
    - DTT_BASE_URL=https://backend.$DDEV_SITENAME.$DDEV_TLD
    - DTT_SCREENSHOT_REPORT_DIRECTORY=/var/www/html/drupal/docroot/sites/simpletest/browser_output
