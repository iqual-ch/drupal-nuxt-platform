server {
  listen 8888 default_server;
  server_name localhost; # certbot_domain:{{ name }}.ddev.site
  server_name_in_redirect off;
  port_in_redirect off;
  large_client_header_buffers 4 32k;
  fastcgi_buffers 32 256k;
  fastcgi_buffer_size 512k;
  proxy_buffers 32 256k;
  proxy_buffer_size 128k;
  proxy_busy_buffers_size    256k;
  server_tokens off;

  root /var/www/html/drupal/docroot;
  index index.php index.htm index.html;

  client_max_body_size 100M;
  
  error_page 404 @errorpage;
  

  
  error_log /dev/stdout info;
  access_log /var/log/nginx/access.log;
  

  # Language of the SSI error page (frontend/public/error.html falls back to de).
  set $lang "de";
  if ($request_uri ~ "^/([a-z]{2})/") {
    set $lang $1;
  }

  location @errorpage {
    root "/var/www/html/frontend/public";
    ssi on;
    internal;
    try_files /error.html =404;
  }

  location /nginx_status {
      stub_status;
      access_log off;
  }

  location = /favicon.ico {
    log_not_found off;
    access_log off;
  }

  location = /robots.txt {
    allow all;
    log_not_found off;
    access_log off;
  }

  location ~ \..*/.*\.php$ {
    return 403;
  }

  location ~ ^/sites/.*/private/ {
    return 403;
  }

  # Allow "Well-Known URIs" as per RFC 5785
  location ~* ^/.well-known/ {
    allow all;
  }

  # Block access to "hidden" files and directories whose names begin with a
  # period. This includes directories used by version control systems such
  # as Subversion or Git to store control files.

  location / {
    absolute_redirect off;
    try_files $uri /index.php?$query_string; # For Drupal >= 7
  }

  location @rewrite {
    rewrite ^ /index.php;
  }

  # Don't allow direct access to PHP files in the vendor directory.
  location ~ /vendor/.*\.php$ {
    deny all;
    return 404;
  }

  # In Drupal 8, we must also match new paths where the '.php' appears in
  # the middle, such as update.php/selection. The rule we use is strict,
  # and only allows this pattern with the update.php front controller.
  # This allows legacy path aliases in the form of
  # blog/index.php/legacy-path to continue to route to Drupal nodes. If
  # you do not have any paths like that, then you might prefer to use a
  # laxer rule, such as:
  #   location ~ \.php(/|$) {
  # The laxer rule will continue to work if Drupal uses this new URL
  # pattern with front controllers other than update.php in a future
  # release.
  location ~ '\.php$|^/update.php' {
    fastcgi_split_path_info ^(.+?\.php)(|/.*)$;
    fastcgi_pass unix:/run/php-fpm.sock;
    fastcgi_buffers 16 16k;
    fastcgi_buffer_size 32k;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_param SCRIPT_NAME $fastcgi_script_name;
    fastcgi_index index.php;
    include fastcgi_params;
    fastcgi_intercept_errors off;
    # fastcgi_read_timeout should match max_execution_time in php.ini
    fastcgi_read_timeout 10m;
    fastcgi_param SERVER_NAME $host;
    # Every request reaches DDEV over HTTPS, like the Platform.sh router's
    # X-Client-SSL: Drupal does not trust X-Forwarded-Proto from this proxy
    # (see docs/routing.md).
    fastcgi_param HTTPS on;
  }

  # Prevent clients from accessing to backup/config/source files
  location ~* (?:\.(?:bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op])|~)$ {
      deny all;
  }


  # Handle image styles for Drupal 7+
  location ~ ^/sites/.*/files/styles/ {
      try_files $uri @rewrite;
  }

  # Prevent clients from accessing to backup/config/source files
  location ~* (?:\.(?:bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op])|~)$ {
      deny all;
  }

  ## Regular private file serving (i.e. handled by Drupal).
  location ^~ /system/files/ {
      ## For not signaling a 404 in the error log whenever the
      ## system/files directory is accessed add the line below.
      ## Note that the 404 is the intended behavior.
      log_not_found off;
      access_log off;
      expires 30d;
      try_files $uri @rewrite;
  }

  # Media: images, icons, video, audio, HTC
  location ~* \.(jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|webp|htc)$ {
      try_files $uri @rewrite;
      expires max;
      log_not_found off;
  }

  # js and css always loaded
  location ~* \.(js|css)$ {
      try_files $uri @rewrite;
      expires -1;
      log_not_found off;
  }
}





# frontend (default)
server {
  listen 80 default_server;
  listen 443 ssl http2 default_server;
  listen [::]:443 ssl http2 default_server;
  large_client_header_buffers 4 32k;
  server_tokens off;

  # default_server: also answers worktree hostnames and www.{{ name }}.ddev.site,
  # once added to additional_hostnames to test a www frontend (docs/routing.md).
  server_name {{ name }}.ddev.site www.{{ name }}.ddev.site;

  root "/frontend-public";

  ssl_certificate           /etc/ssl/certs/master.crt;
  ssl_certificate_key       /etc/ssl/certs/master.key;
  

  # Local debug.
  # ssl_certificate           /certs/cert.crt;
  # ssl_certificate_key       /certs/cert.key;

  ssl_verify_client         off;

  # Load the Diffie-Hellman parameter.
  

  ssl_session_cache    shared:SSL:1m;
  ssl_session_timeout  5m;

  ssl_ciphers  HIGH:!aNULL:!MD5;
  ssl_prefer_server_ciphers  on;

  port_in_redirect off;
  client_max_body_size 100M;
  fastcgi_buffers 32 128k;
  fastcgi_buffer_size 128k;
  proxy_buffers 32 256k;
  proxy_buffer_size 128k;
  proxy_busy_buffers_size    256k;

  proxy_read_timeout    190;
  proxy_connect_timeout 3;
  proxy_redirect        off;
  proxy_http_version    1.1;
  proxy_set_header      Host $host;
  proxy_set_header      Upgrade $http_upgrade;
  proxy_set_header      Connection $proxy_connection;
  proxy_set_header      X-Real-IP $remote_addr;
  proxy_set_header      X-Forwarded-Host $host;
  proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header      X-Forwarded-Proto https;
  proxy_set_header      X-Forwarded-Ssl on;
  proxy_set_header      X-Forwarded-Port $proxy_x_forwarded_port;
  proxy_set_header      Proxy "";

  error_page 400 401 402 403 404 405 406 407 408 409 410 411 412 413 414 415 416 417 418 421 422 423 424 425 426 428 429 431 451 500 501 502 503 504 505 506 507 508 510 511 @errorpage;

  location /nginx {
    ssi on;
  }

  
  error_log /dev/stdout info;
  access_log /var/log/nginx/access.log;
  include /etc/nginx/monitoring.conf;
  

  # Language of the SSI error page (frontend/public/error.html falls back to de).
  set $lang "de";
  if ($request_uri ~ "^/([a-z]{2})/") {
    set $lang $1;
  }

  location @errorpage {
    root "/var/www/html/frontend/public";
    ssi on;
    internal;
    try_files /error.html =404;
  }

  

  

  location @drupal {
    proxy_intercept_errors off;
    proxy_pass http://localhost:8888;
  }

  location @frontend {
    proxy_intercept_errors on;
    
      error_page 502 = @drupal;
    
    proxy_pass http://localhost:3000;
  }

  # Unblock specific files which would be blocked due to their file extension.
  location = /sitemap.xml {
    try_files false @drupal;
  }

  location = /robots.txt {
    try_files false @frontend;
  }

  # {-% include "templates/spam.conf" %-}

  location ^~ /sites/default/files {
    auth_basic off;
    try_files $uri $uri/ @drupal;
  }

  # Drupal's editorial entry points requested on the frontend domain redirect
  # to the backend domain; every other Drupal path the frontend hands over
  # itself (see docs/routing.md).
  location ~ "^/([a-z]{2}/)?(admin|user)([/?]|$)" {
    return 302 https://backend.$site_domain$request_uri;
  }

  # The sitemap's XSL must be same-origin (/sitemap.xml is handled above).
  location ^~ /sitemap_generator {
    try_files "" @drupal;
  }

  location /api {
    proxy_intercept_errors off;
    auth_basic off;
    proxy_pass http://localhost:3000;
  }

  location /nginx_status {
    stub_status;
    access_log off;
  }

  location /__nuxt {
    auth_basic off;
    access_log off;
    expires 365d;
    add_header Cache-Control public;
    try_files $uri $uri/ @frontend;
  }

  location /_nuxt {
    expires 365d;
    auth_basic off;
    access_log off;
    try_files $uri $uri/ @frontend;
  }

  location ~* "(favicon|logo-[a-z]{2})" {
    expires 7d;
    add_header Cache-Control public;
    add_header Vary Accept-Encoding;
    access_log off;
    try_files $uri $uri/ @frontend;
  }

  location ~*  \.(woff|woff2|ttf|otf)$ {
    expires 365d;
    try_files $uri $uri/ @frontend;
  }

  location / {
    try_files $uri $uri/ @frontend;
  }

}

# backend: the Drupal site on its own hostname ("backend." + project
# hostname, also in worktrees), proxied to the Drupal server above.
server {
  listen 80;
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  large_client_header_buffers 4 32k;
  server_tokens off;

  server_name ~^backend\.;

  ssl_certificate           /etc/ssl/certs/master.crt;
  ssl_certificate_key       /etc/ssl/certs/master.key;
  ssl_verify_client         off;
  ssl_session_cache    shared:SSL:1m;
  ssl_session_timeout  5m;
  ssl_ciphers  HIGH:!aNULL:!MD5;
  ssl_prefer_server_ciphers  on;

  port_in_redirect off;
  client_max_body_size 100M;
  proxy_buffers 32 256k;
  proxy_buffer_size 128k;
  proxy_busy_buffers_size    256k;

  proxy_read_timeout    600;
  proxy_connect_timeout 3;
  proxy_redirect        off;
  proxy_http_version    1.1;
  proxy_set_header      Host $host;
  proxy_set_header      X-Real-IP $remote_addr;
  proxy_set_header      X-Forwarded-Host $host;
  proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header      X-Forwarded-Proto https;
  proxy_set_header      X-Forwarded-Ssl on;
  proxy_set_header      X-Forwarded-Port $proxy_x_forwarded_port;
  proxy_set_header      Proxy "";

  error_log /dev/stdout info;
  access_log /var/log/nginx/access.log;

  location / {
    proxy_intercept_errors off;
    proxy_pass http://localhost:8888;
  }
}
