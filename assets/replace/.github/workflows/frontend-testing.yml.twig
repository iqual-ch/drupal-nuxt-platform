{% if workflows.frontend %}
{%- verbatim -%}
name: Frontend testing

on:
  workflow_dispatch:
  workflow_call:

concurrency:
  group: ci-frontend-testing-${{ github.ref }}
  cancel-in-progress: true

# No DDEV here: the frontend checks run on plain bun on the runner. The
# `postinstall` script of `bun install` runs `nuxt prepare`, which generates the
# types and GraphQL operations the checks need from the committed
# `schema.graphql` — no Drupal backend and no secrets involved.
defaults:
  run:
    shell: bash
    working-directory: frontend

jobs:
  prettier:
    name: "Prettier"
    runs-on: ubuntu-latest

    steps:
    - name: Checkout
      uses: actions/checkout@v6

    - name: "Set up Bun"
      uses: oven-sh/setup-bun@v1

    - name: "Install dependencies"
      run: bun install --frozen-lockfile

    - name: "Check formatting"
      run: bun run prettier

  eslint:
    name: "ESLint"
    runs-on: ubuntu-latest

    # TODO: make this job blocking once the ESLint errors are fixed.
    continue-on-error: true

    steps:
    - name: Checkout
      uses: actions/checkout@v6

    - name: "Set up Bun"
      uses: oven-sh/setup-bun@v1

    - name: "Install dependencies"
      run: bun install --frozen-lockfile

    - name: "Generate the Nuxt ESLint config"
      # `eslint.config.mjs` imports the flat config generated by `@nuxt/eslint`,
      # a module the layer only loads in dev mode — so ESLint needs a second,
      # dev-mode prepare. `CI` keeps that one from introspecting the (absent)
      # Drupal backend and from writing into the Drupal config directory.
      run: bunx nuxt prepare
      env:
        NODE_ENV: development

    - name: "Run ESLint"
      run: bun run lint

  vitest:
    name: "Vitest"
    runs-on: ubuntu-latest

    steps:
    - name: Checkout
      uses: actions/checkout@v6

    - name: "Set up Bun"
      uses: oven-sh/setup-bun@v1

    - name: "Install dependencies"
      run: bun install --frozen-lockfile

    # The shared config from @iqual/nuxt-icms-dev (wrapped by the project's
    # vitest.config.mts) runs the product specs shipped in @iqual/nuxt-icms*
    # plus the project's own, passes without project specs and writes the
    # JUnit report whenever CI is set.
    - name: "Run Vitest"
      run: bun run test:ci

    - name: "Upload the JUnit report"
      if: ${{ !cancelled() }}
      uses: actions/upload-artifact@v7
      with:
        name: frontend-test-results
        # Paths are relative to the workspace, not to the run default.
        path: frontend/test-results/junit.xml
        if-no-files-found: warn

  typecheck:
    name: "Typecheck"
    runs-on: ubuntu-latest

    # TODO: make this job blocking once the vue-tsc errors are fixed.
    continue-on-error: true

    steps:
    - name: Checkout
      uses: actions/checkout@v6

    - name: "Set up Bun"
      uses: oven-sh/setup-bun@v1

    - name: "Install dependencies"
      run: bun install --frozen-lockfile

    - name: "Run vue-tsc"
      run: bun run typecheck
{% endverbatim -%}
{% endif %}
