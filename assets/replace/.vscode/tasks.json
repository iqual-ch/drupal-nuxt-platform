{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Project: Install",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "make install-safe"
        },
        {
            "label": "Project: Install (force)",
            "type": "shell",
            "group": "build",
            "command": "make install"
        },
        {
            "label": "Drupal: build & deploy",
            "type": "shell",
            "group": "build",
            "command": "make drupal"
        },
        {
            "label": "Frontend: build & deploy",
            "type": "shell",
            "group": "build",
            "command": "make frontend"
        },
        {
            "label": "Project: Start local DDEV runtime",
            "type": "shell",
            "command": "make runtime"
        },
        {
            "label": "Project: Run tests",
            "type": "shell",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "command": "make test"
        },
        {
            "label": "Drupal: Run tests (PHPUnit)",
            "type": "shell",
            "group": "test",
            "command": "make drupal-test"
        },
        {
            "label": "Frontend: Run tests (Vitest)",
            "type": "shell",
            "group": "test",
            "command": "make frontend-test"
        },
        {
            "label": "Project: Run linting",
            "type": "shell",
            "group": "test",
            "command": "make test"
        },
        {
            "label": "Drupal: Run linting (PHPCS)",
            "type": "shell",
            "group": "test",
            "command": "make drupal-lint"
        },
        {
            "label": "Frontend: Run linting",
            "type": "shell",
            "group": "test",
            "command": "make frontend-lint"
        },
        {
            "label": "DDEV: Enable Xdebug",
            "type": "shell",
            "command": "ddev xdebug on",
            "presentation": {
                "reveal": "silent",
                "close": true
            }
        },
        {
            "label": "DDEV: Disable Xdebug",
            "type": "shell",
            "command": "ddev xdebug off",
            "presentation": {
                "reveal": "silent",
                "close": true
            }
        },
    ]
}
