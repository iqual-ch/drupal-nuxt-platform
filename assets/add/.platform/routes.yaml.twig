{% if deployment == "platform.sh" %}
# The frontend serves the public site; the Drupal backend lives on the
# "backend." subdomain (see docs/routing.md). Drupal's editorial entry points
# requested on the frontend domain redirect there, every other Drupal path the
# frontend hands over itself; public files, the sitemap and its XSL stay on the
# frontend domain and are routed to Drupal directly.
"https://{default}/":
    type: upstream
    upstream: "{{ routing.cache|default('none') == 'varnish' ? 'varnish:http' : 'frontend:http' }}"
    primary: true
    id: frontend
    cache:
        enabled: false
    tls:
      strict_transport_security:
          enabled: true
          include_subdomains: true
          preload: true
    redirects:
        paths:
            '^/((?:[a-z]{2}/)?(?:admin|user)(?:[/?].*)?)$':
                to: "https://backend.{default}/$1$is_args$args"
                regexp: true

"https://{default}/sites/default/files":
    type: upstream
    upstream: "drupal:http"
    cache:
        enabled: true
    tls:
      strict_transport_security:
          enabled: true
          include_subdomains: true
          preload: true

"https://{default}/sitemap.xml":
    type: upstream
    upstream: "drupal:http"
    cache:
        enabled: false
    tls:
      strict_transport_security:
          enabled: true
          include_subdomains: true
          preload: true

"https://{default}/sitemap_generator":
    type: upstream
    upstream: "drupal:http"
    cache:
        enabled: true
    tls:
      strict_transport_security:
          enabled: true
          include_subdomains: true
          preload: true

"https://backend.{default}/":
    type: upstream
    upstream: "drupal:http"
    id: backend
    cache:
        enabled: false
    tls:
      strict_transport_security:
          enabled: true
          include_subdomains: true
          preload: true

# Cloudflare Images proxy, if domain is not on CF.
"https://{default}/cdn-cgi/image":
  type: proxy
  to: "https://iqual.cloud/cdn-cgi/image"
{% endif %}
