{% if deployment == "platform.sh" %}
{% set frontend = routing.www|default(false) ? 'www.{default}' : '{default}' %}
# The frontend serves the public site; the Drupal backend lives on
# backend.{default} (see docs/routing.md). Drupal's editorial entry points
# requested on the frontend domain redirect there, every other Drupal path the
# frontend hands over itself; public files, the sitemap and its XSL stay on the
# frontend domain and are routed to Drupal directly.
"https://{{ frontend }}/":
    type: upstream
    upstream: "{{ routing.cache|default('none') == 'varnish' ? 'varnish:http' : 'frontend:http' }}"
    primary: true
    id: frontend
    cache:
        enabled: false
    tls:
      strict_transport_security:
          enabled: true
          include_subdomains: true
          preload: true
    redirects:
        paths:
            '^/((?:[a-z]{2}/)?(?:admin|user)(?:[/?].*)?)$':
                to: "https://backend.{default}/$1$is_args$args"
                regexp: true

"https://{{ frontend }}/sites/default/files":
    type: upstream
    upstream: "drupal:http"
    cache:
        enabled: true
    tls:
      strict_transport_security:
          enabled: true
          include_subdomains: true
          preload: true

"https://{{ frontend }}/sitemap.xml":
    type: upstream
    upstream: "drupal:http"
    cache:
        enabled: false
    tls:
      strict_transport_security:
          enabled: true
          include_subdomains: true
          preload: true

"https://{{ frontend }}/sitemap_generator":
    type: upstream
    upstream: "drupal:http"
    cache:
        enabled: true
    tls:
      strict_transport_security:
          enabled: true
          include_subdomains: true
          preload: true

"https://backend.{default}/":
    type: upstream
    upstream: "drupal:http"
    id: backend
    cache:
        enabled: false
    tls:
      strict_transport_security:
          enabled: true
          include_subdomains: true
          preload: true
{% if routing.www|default(false) %}

"https://{default}/":
    type: redirect
    to: "https://www.{default}/"
{% endif %}

# Cloudflare Images proxy, if domain is not on CF.
"https://{{ frontend }}/cdn-cgi/image":
  type: proxy
  to: "https://iqual.cloud/cdn-cgi/image"
{% endif %}
